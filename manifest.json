{
  "manifest_version": 3,
  "name": "my dog ate my homework",
  "version": "1.0.0",
  "description": "A small pixel-art dog that eats your typed text if you don't feed him treats on time.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pixel-dog@antigravity.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/config.js",
        "src/eater.js",
        "src/dog.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "my dog ate my homework"
  }
}
